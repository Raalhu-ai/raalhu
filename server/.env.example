# Antigravity uses the installed-app OAuth identity referenced in src/antigravity-oauth.ts.
# Do not configure a developer-owned OAuth client: it cannot obtain the required scopes.
# Local development: set these in .dev.vars. Production: set as Worker secrets.
ANTIGRAVITY_OAUTH_CLIENT_ID=your-antigravity-installed-app-client-id
ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-antigravity-installed-app-client-secret

# Must remain at or above 2.9.1. Update deliberately as Antigravity releases change.
ANTIGRAVITY_CLIENT_VERSION=2.9.1

# Cloudflare KV namespace IDs
# Create with: wrangler kv:namespace create AUTH_SESSIONS
#              wrangler kv:namespace create SESSIONS
KV_AUTH_SESSIONS_ID=your-auth-sessions-namespace-id
KV_SESSIONS_ID=your-sessions-namespace-id

# CORS origin for frontend (defaults to http://localhost:5173)
# CORS_ORIGIN=https://your-domain.com
